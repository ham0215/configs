{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-single-command.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [],
    "deny": [],
    "defaultMode": "acceptEdits"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {},
  "autoUpdatesChannel": "latest",
  "voiceEnabled": false,
  "skipAutoPermissionPrompt": true,
  "teammateMode": "tmux"
}
